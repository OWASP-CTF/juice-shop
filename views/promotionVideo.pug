doctype html
html(lang='en')
    head
        title _title_
        meta(charset='utf-8')
        meta(name='description', content='')
        meta(name='keywords', content='')
        meta(name='viewport' content='width=device-width, initial-scale=1.0')
        link(rel='icon', type='image/x-icon', href='./assets/public/_favicon_')
        link(rel='stylesheet', href='/vendor/beercss/beer.min.css')
        link(rel='stylesheet', href='/vendor/material-icons/material-icons.css')
        link(rel='stylesheet', href='./assets/public/css/roboto.css', type='text/css')
        script(type='module', src='/vendor/beercss/beer.min.js')
        style.
            body { background: _bgColor_ !important; color: _textColor_ !important; }
            article { background: _primLight_ !important; }
            .brand { display: flex; align-items: center; gap: 8px; text-decoration: none; color: _textColor_; }
            .brand img { max-height: 50px; width: auto; }
            .brand span { font: 500 20px/32px Roboto,"Helvetica Neue",sans-serif; }
            video {
            min-width: 320px;
            width: 100%;
            display: block;
            margin-bottom: 5px;
            height: 50vh;
            outline: none;
            }
            @media (max-width: 900px) {
              .app-title {
                display: none !important;
              }
            }
    body
        header(style='background: _navColor_; padding: 8px 16px;')
          nav
            a(href='./#/' style='color: _textColor_; text-decoration:none;')
              i.material-icons arrow_back
            a(href='./#/' style='color: _textColor_; text-decoration:none;') Back
            a.brand(href='./#/')
              img(src='assets/public/images/JuiceShop_Logo.png', alt='_title_ Logo')
              span.app-title _title_
            div.max

        main(style='padding: 16px;')
          article(style='min-width: 320px; max-width: 700px; margin: 24px auto 50px; padding: 16px; border-radius: 12px;')
            h5(style='color: _textColor_;') Promotion Video
            video(controls='controls')
               source(src='./video', type='video/mp4')
               track(src='./assets/public/videos/_subtitles_', kind='subtitles', srclang='en', label='English', default)
