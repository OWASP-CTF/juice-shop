  "vulnerabilities": [
    {
      "notes": [
        {
          "category": "details",
          "text": "The build toolchain briefly resolved eslint-scope 3.7.2, a release published from a compromised maintainer account that exfiltrated npm credentials from the machines that installed it. No customer of the shop is affected; the exposure is to the development team's own registry credentials. The affected release is no longer resolvable by this project and the credentials it could have reached have been rotated.",
          "title": "Compromised eslint-scope release harvested developer npm credentials"
        }
      ],
      "product_status": {
        "known_affected": [
          "juice-shop/juice-shop"
        ]
      },
      "remediations": [
        {
          "category": "vendor_fix",
          "date": "2018-07-12T10:00:00.000Z",
          "details": "Move off the compromised release to eslint-scope 3.7.3 or later and rotate every npm token the build machines held.",
          "product_ids": [
            "juice-shop/juice-shop"
          ],
          "url": "https://github.com/eslint/eslint-scope/issues/39"
        }
      ],
